[gd_resource type="Resource" script_class="CraftRecipe" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/data/craft_recipe.gd" id="recipe"]
[ext_resource type="Script" path="res://scripts/data/recipe_entry.gd" id="entry"]
[ext_resource type="Resource" path="res://resources/items/ice_crystal.tres" id="lead"]
[ext_resource type="Resource" path="res://resources/items/paper.tres" id="paper"]
[ext_resource type="Resource" path="res://resources/items/copper.tres" id="copper"]
[ext_resource type="Resource" path="res://resources/items/ice_ammo.tres" id="output"]

[sub_resource type="Resource" id="lead_entry"]
script = ExtResource("entry")
item = ExtResource("lead")
quantity = 1

[sub_resource type="Resource" id="paper_entry"]
script = ExtResource("entry")
item = ExtResource("paper")
quantity = 1

[sub_resource type="Resource" id="copper_entry"]
script = ExtResource("entry")
item = ExtResource("copper")
quantity = 1

[sub_resource type="Resource" id="result_entry"]
script = ExtResource("entry")
item = ExtResource("output")
quantity = 10

[resource]
script = ExtResource("recipe")
recipe_id = &"ice_ammo"
display_name = "Ice Ammo"
description = "Crafting foundation; not usable in the Basic Rifle yet."
category = 0
ingredients = Array[Resource]([SubResource("lead_entry"), SubResource("paper_entry"), SubResource("copper_entry")])
outputs = Array[Resource]([SubResource("result_entry")])
craft_amount = 1
unlock_day = 5
