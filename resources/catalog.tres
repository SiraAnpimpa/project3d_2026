[resource]
script = ExtResource("script")
items = Array[Resource]([ExtResource("seed_lead"), ExtResource("lead"), ExtResource("seed_paper"), ExtResource("paper"), ExtResource("seed_iron"), ExtResource("iron"), ExtResource("seed_copper"), ExtResource("copper"), ExtResource("seed_small_herb"), ExtResource("small_herb"), ExtResource("basic_ammo"), ExtResource("basic_medicine"), ExtResource("metal_component")])
plants = Array[Resource]([ExtResource("plant_lead"), ExtResource("plant_paper"), ExtResource("plant_iron"), ExtResource("plant_copper"), ExtResource("plant_small_herb")])
