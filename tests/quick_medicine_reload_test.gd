extends "res://tests/phase_5_weapon_test.gd"

func run() -> void:
	root.size = Vector2i(1280, 720)
	set_meta("normal_play", true)
	var game = load("res://scenes/main/GameRoot.tscn").instantiate()
	root.add_child(game)
	current_scene = game
	await game.wait_until_ready()
	game.clock.set_process(false)
	game.waves.enabled = false
	game.seed_rewards.process_mode = Node.PROCESS_MODE_DISABLED
	var player: PlayerController = game.player
	player.set_physics_process(false)
	player.camera_rig._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	player.camera_rig.capture_mouse()
	await frames(4)
	var bag: Inventory = game.inventory
	var use: ConsumableUse = game.consumables
	var weapons: WeaponController = game.weapons
	var basic: ItemData = game.catalog.get_item(&"basic_medicine")
	var full: ItemData = game.catalog.get_item(&"large_medicine")
	check(basic != null and full != null and use.can_use_input(), "medicine definitions and gameplay input are ready")
	bag.add_item(basic, 3)
	bag.add_item(full, 3)
	bag.add_item(game.catalog.get_item(&"ice_grenade"), 2)
	player.health._set_hp(40)
	var shoulder := player.camera_rig.shoulder_side
	key(KEY_V)
	check(use.selected_medicine == full and bag.get_item_amount(full.id) == 3 and bag.get_item_amount(basic.id) == 3, "V selects Full without consuming either medicine")
	key(KEY_Z)
	check(player.camera_rig.shoulder_side == -shoulder and use.selected_medicine == full and bag.get_item_amount(&"ice_grenade") == 2, "Z switches shoulder without switching medicine or throwing a grenade")
	check(game.hud._medicine_icon.texture == full.icon and game.hud._medicine_hint.text == "Full heal" and game.hud._medicine_switch.visible, "HUD shows the selected full-heal icon, count and swap key")
	await capture("full_medicine_selected")
	key(KEY_F)
	check(player.health.current_hp == 100 and bag.get_item_amount(full.id) == 2 and bag.get_item_amount(basic.id) == 3, "F uses the selected Full medicine and restores all HP")
	key(KEY_V)
	player.health._set_hp(40)
	key(KEY_F)
	check(use.selected_medicine == basic and player.health.current_hp == 40 and bag.get_item_amount(basic.id) == 3, "switching medicine cannot bypass the shared use cooldown")
	await frames(34)
	key(KEY_F)
	check(player.health.current_hp == 70 and bag.get_item_amount(basic.id) == 2 and bag.get_item_amount(full.id) == 2, "F after switching back consumes only Basic and heals thirty")
	await frames(34)
	player.health._set_hp(40)
	key(KEY_V)
	key(KEY_F)
	check(player.health.current_hp == 100 and bag.get_item_amount(full.id) == 1 and use.selected_medicine == full, "F uses Full after deliberate V selection")
	key(KEY_V)
	await frames(34)
	key(KEY_F)
	check(bag.get_item_amount(basic.id) == 2, "full HP never wastes selected medicine")
	game.inventory_ui.set_open(true)
	key(KEY_V)
	key(KEY_F)
	key(KEY_G)
	check(use.selected_medicine == basic and bag.get_item_amount(full.id) == 1 and bag.get_item_amount(basic.id) == 2, "inventory modal blocks medicine selection and both use shortcuts")
	game.inventory_ui.set_open(false)
	player.camera_rig.capture_mouse()
	await frames(3)
	root.size = Vector2i(1024, 768)
	player.health._set_hp(40)
	await frames(4)
	check(Rect2(Vector2.ZERO, Vector2(root.size)).encloses(game.hud._medicine_row.get_global_rect()) and game.hud._medicine_row.get_global_rect().end.y < game.hud._stats_panel.get_global_rect().position.y, "selected medicine HUD fits 4:3 and stays above the health panel")
	await capture("medicine_swap_4x3")
	root.size = Vector2i(1280, 720)
	key(KEY_Q)
	await frames(3)
	key(KEY_V)
	check(use.selected_medicine == full and bag.get_item_amount(&"ice_grenade") == 2, "V switches medicine in Combat without throwing a grenade")
	key(KEY_G)
	check(bag.get_item_amount(&"ice_grenade") == 1 and bag.get_item_amount(full.id) == 1 and player.health.current_hp == 40, "G throws exactly one grenade and never consumes medicine or heals")
	var state := weapons.current
	check(state.data.weapon_id == &"pistol" and state.current_magazine == 0 and not state.is_reloading, "empty pistol with no reserve stays idle")
	bag.add_item(game.catalog.get_item(&"basic_ammo"), 15)
	await frames(2)
	check(state.is_reloading and state.current_magazine == 0 and bag.get_item_amount(&"basic_ammo") == 15, "empty Combat weapon automatically starts a timed reload without early ammo transfer")
	key(KEY_Q)
	await frames(2)
	check(not state.is_reloading and state.current_magazine == 0 and bag.get_item_amount(&"basic_ammo") == 15, "Farming cancels auto reload without spending reserve")
	key(KEY_Q)
	await frames(2)
	check(state.is_reloading, "returning to Combat resumes auto reload for an empty weapon")
	game.pause_menu.set_open(true)
	await frames(2)
	check(not state.is_reloading and state.current_magazine == 0 and bag.get_item_amount(&"basic_ammo") == 15, "Pause cancels auto reload and preserves reserve")
	game.pause_menu.set_open(false)
	player.camera_rig.capture_mouse()
	await frames(int(ceil(state.data.reload_time * 60)) + 8)
	check(not state.is_reloading and state.current_magazine == 12 and bag.get_item_amount(&"basic_ammo") == 3, "resume automatically completes one normal twelve-round reload")
	state.current_magazine = 1
	var shots := weapons.shots_fired
	mouse(MOUSE_BUTTON_RIGHT, true)
	await frames(3)
	mouse(MOUSE_BUTTON_LEFT, true)
	mouse(MOUSE_BUTTON_LEFT, false)
	check(weapons.shots_fired == shots + 1 and state.current_magazine == 0 and state.is_reloading and bag.get_item_amount(&"basic_ammo") == 3, "firing the last bullet starts auto reload immediately and commits one shot")
	mouse(MOUSE_BUTTON_RIGHT, false)
	await frames(int(ceil(state.data.reload_time * 60)) + 5)
	check(state.current_magazine == 3 and not state.is_reloading and bag.get_item_amount(&"basic_ammo") == 0, "partial reserve transfers exactly the remaining three rounds")
	state.current_magazine = 0
	await frames(5)
	check(not state.is_reloading and state.current_magazine == 0, "zero reserve never creates ammunition or restarts an empty reload")
	state.selected_ammo_type = game.catalog.get_item(&"fire_ammo")
	state.magazine_ammo_type = state.selected_ammo_type
	bag.add_item(game.catalog.get_item(&"basic_ammo"), 3)
	await frames(2)
	check(state.is_reloading and state.selected_ammo_type.id == &"basic_ammo", "depleted elemental ammo automatically falls back to owned Basic reserve")
	game.equipment.cycle_weapon(1)
	await frames(3)
	check(not state.is_reloading and weapons.current.data.is_melee() and not weapons.current.is_reloading and bag.get_item_amount(&"basic_ammo") == 3, "switching to a melee weapon cancels auto reload and never spends rounds")
	game.equipment.cycle_weapon(1)
	await frames(int(ceil(state.data.reload_time * 60)) + 5)
	check(weapons.current == state and state.current_magazine == 3 and bag.get_item_amount(&"basic_ammo") == 0, "reequipping the empty gun completes auto reload using its existing runtime")
	bag.remove_item(basic.id, 2)
	check(not use.cycle_medicine() and use.selected_medicine == full, "switching to an unavailable medicine keeps the deliberate selection")
	player.health._set_hp(40)
	key(KEY_F)
	await frames(34)
	check(bag.get_item_amount(full.id) == 0 and player.health.current_hp == 100 and not game.hud._medicine_row.visible, "last Full medicine heals once and hides the empty medicine HUD")
	game.queue_free()
	await frames(5)
	print("QUICK_MEDICINE_RELOAD_RESULT failures=", failures)
	quit(1 if failures else 0)
